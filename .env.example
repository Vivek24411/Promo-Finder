# Server only. Copy values into your existing .env; never overwrite it blindly.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MODEL=claude-sonnet-5-5
# Set the current USD per million token rates for YOUR selected models.
# Blank/unknown pricing blocks paid calls; no assumption that unknown means free.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
CLAUDE_INPUT_USD_PER_MILLION=
CLAUDE_OUTPUT_USD_PER_MILLION=
MAX_RUN_COST_USD=2.00
MAX_RUN_SECONDS=1200
FINAL_REVIEW_LIMIT=60
AUDIT_SAMPLE_SIZE=4
GEMINI_RPM=12
CLAUDE_RPM=12
PROMO_FINDER_PUBLIC=0
