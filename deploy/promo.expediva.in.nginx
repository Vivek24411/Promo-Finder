# ======================================
# PROMO FINDER (promo-finder container, ~/promo-finder)
# Domain: promo.expediva.in
# Container: promo-finder (Streamlit, see Dockerfile)
# Port: 127.0.0.1:8511
# Install: /etc/nginx/sites-available/promo.expediva.in, symlinked into sites-enabled.
# HTTPS is added by: sudo certbot --nginx -d promo.expediva.in
# ======================================

upstream promo-finder-app {
    server 127.0.0.1:8511;
}

server {
    listen 80;
    listen [::]:80;
    server_name promo.expediva.in;

    client_max_body_size 100M;          # matches server.maxUploadSize in .streamlit/config.toml

    location / {
        proxy_pass http://promo-finder-app;
        proxy_http_version 1.1;
        # Streamlit talks to the browser over a WebSocket (/_stcore/stream).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;       # a full-show run can take several minutes
        proxy_buffering off;
    }
}
